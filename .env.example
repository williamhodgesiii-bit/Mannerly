# Mannerly — environment
#
# Copy this file to `.env` and fill in your Supabase project values to turn on
# real accounts (sign up, sign in, sessions, password reset) that work across
# devices. With these left blank, the app runs on the on-device account
# stand-in and the seeded dev logins (see docs/store/supabase-setup.md).
#
# Find these in your Supabase project: Settings → API.
# The anon key is a public client key — Row Level Security protects the data.

VITE_SUPABASE_URL=https://ahlmrgpiqdkldhqhmnqx.supabase.co/rest/v1/
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImFobG1yZ3BpcWRrbGRocWhtbnF4Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODY0NTM0MjYsImV4cCI6MjEwMjAyOTQyNn0.LP2zIxRgU40wLVAaVE2tn8auE4EPMa2bQ_jwbhnzoCA
