{
  "name": "mannerly",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Mannerly — Duolingo for manners, etiquette & cultural fluency.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc -b --noEmit",
    "seed:users": "node scripts/seed-users.mjs",
    "cap:sync": "cap sync",
    "cap:ios": "cap add ios && cap sync ios && cap open ios",
    "cap:android": "cap add android && cap sync android && cap open android"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "framer-motion": "^11.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/cli": "^6.1.2",
    "@capacitor/core": "^6.1.2",
    "@capacitor/ios": "^6.1.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.0",
    "vite-plugin-pwa": "^0.20.1"
  }
}
